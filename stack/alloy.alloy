// Backend services: OTLP in, traces to Tempo
otelcol.receiver.otlp "apps" {
  http { endpoint = "0.0.0.0:4318" }
  output { traces = [otelcol.exporter.otlphttp.tempo.input] }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://127.0.0.1:4418"
    tls { insecure = true }
  }
}

// Phones: Faro in, logs to Loki, traces to Tempo
faro.receiver "apps" {
  extra_log_labels = { app_name = "", app_environment = "", kind = "" }
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    cors_allowed_origins     = ["*"]
    max_allowed_payload_size = "5MiB"
    // default is ONE global bucket of 50 req/s, burst 100, for all clients together (replay and real fleets hit it)
    rate_limiting {
      enabled    = true
      rate       = 2000
      burst_size = 4000
    }
  }
  output {
    logs   = [loki.write.faro.receiver]
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

loki.write "faro" {
  endpoint { url = "http://127.0.0.1:3100/loki/api/v1/push" }
}
